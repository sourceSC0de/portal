# Whop OAuth credentials (from the Whop Developer Dashboard)
WHOP_CLIENT_ID=app_REPLACE_ME
WHOP_CLIENT_SECRET=REPLACE_ME
# Server-side Whop app API key needed for embedded token verification
WHOP_API_KEY=REPLACE_ME
# true for Whop Sandbox; false for Production
WHOP_SANDBOX=true
# At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# No trailing slash. For local development use http://localhost:3000
APP_URL=http://localhost:3000

# Supabase project settings. The service role key is SERVER-ONLY; never prefix it with NEXT_PUBLIC_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Optional: current downloadable indicator bundle
INDICATOR_DOWNLOAD_URL=https://www.dropbox.com/scl/fi/ghsaz6p2ni58beetjhrqw/Indicators.zip?rlkey=81b9gjcl8p88hobk3u6306x2x&dl=1 
